# 백엔드 환경변수 예시
# 프로덕션에서는 이 파일을 복사해 .env 로 만들고 실제 값을 채웁니다.
# 데모/로컬에서는 아래 .env (demo) 를 사용합니다.

# 백엔드 URL (프론트가 호출하는 주소)
BACKEND_URL=http://localhost:8000

# 프론트 URL (CORS 허용)
FRONTEND_URL=http://localhost:3000

# 허용할 오리진 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# LLM 호출 방식: true 면 Solar Pro 4 mock 사용
LLM_USE_MOCK=true

# --- Notion OAuth (추후 입력) ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://your-backend.example.com/api/auth/notion/callback

# --- Google OAuth (추후 입력, 테스트 사용자) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.example.com/api/auth/google/callback
